{
  "compilerOptions": {
    "target": "ES2018", "module": "ESNext", "jsx": "react-jsx",
    "lib": ["ES2018", "DOM"], "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
